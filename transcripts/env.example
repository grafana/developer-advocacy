# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/
# 1. Go to a GCP project
# 2. Make sure YouTube Data API v3 is enabled
# 3. Create an API key in that project
API_KEY=your_youtube_api_key_here

# OpenAI API Configuration (optional)
# Only needed if you want AI-powered summaries and cleanup
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Official YouTube captions API (optional; needed on cloud runners)
# Produce the refresh token with: python3 get_refresh_token.py (see README.md, "How this runs").
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# Quota units one run may spend (default 9000 of the 10,000 per day)
# YOUTUBE_QUOTA_BUDGET=9000
